{
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "cd frontend && npm install",
  "crons": [
    {
      "path": "/api/agent/run",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/email/digest",
      "schedule": "0 9 * * 1"
    }
  ]
}
