# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
/coverage
# next.js
/.next/
/out/
# production
/build
# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files (can opt-in for committing if needed)
.env*
# vercel
.vercel
# runtime data (written by the live agent/store, not committed)
/data/*.json
/data/*.json.tmp
# typescript
*.tsbuildinfo
next-env.d.ts
processed_items.db
*-dry-run*.json
research-*.json
consensus-classification-investigation.json
migration-dry-run-report.json
